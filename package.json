{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": "^24.15.0",
    "npm": "12.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.1",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true,
    "fsevents": false
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:browser": "vite --port=3000 --host=127.0.0.1 --strictPort",
    "dev:layout-browser": "vite --port=3001 --host=127.0.0.1 --strictPort",
    "dev:city-browser": "npm run dev:layout-browser",
    "build": "vite build",
    "build:alpha": "vite build --mode alpha --sourcemap hidden",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "smoke:game-api": "node scripts/smoke-game-api.mjs",
    "test:integration": "node scripts/test-temporal-concurrency.mjs",
    "test:e2e": "vitest run tests/authoritativePipeline.e2e.test.tsx",
    "test:browser": "playwright test",
    "test:layout-browser": "playwright test --config=playwright.layout.config.ts",
    "test:city-browser": "npm run test:layout-browser",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:logs": "node scripts/check-log-safety.mjs",
    "preview": "vite preview",
    "board": "node workboard/server/server.mjs",
    "board:start": "powershell -NoProfile -ExecutionPolicy Bypass -File workboard/scripts/start.ps1",
    "board:start:hidden": "powershell -NoProfile -ExecutionPolicy Bypass -File workboard/scripts/start-hidden.ps1",
    "board:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File workboard/scripts/stop.ps1",
    "board:validate": "node workboard/scripts/validate.mjs",
    "board:sync": "node workboard/scripts/sync-github.mjs",
    "board:sync:apply": "node workboard/scripts/sync-github.mjs --apply",
    "check:determinism": "node scripts/check-determinism.mjs",
    "check:catalog": "node --experimental-strip-types scripts/generate-item-catalog-matrix.mjs --check",
    "supabase:verify": "node supabase/verify-local.mjs",
    "supabase:revoke-allowlist": "node supabase/scripts/revoke-allowlist.mjs",
    "test:db": "supabase test db",
    "typecheck": "tsc --noEmit && node --experimental-strip-types scripts/generate-item-catalog-matrix.mjs --check",
    "lint": "eslint src tests",
    "test": "vitest",
    "test:dungeon-simulation": "vitest run tests/dungeonRulesSimulation.test.ts tests/dungeonEncounterRules.test.ts --reporter=verbose",
    "test:dungeon-challenge-simulation": "vitest run tests/dungeonChallengeRules.test.ts tests/dungeonChallengeSimulation.test.ts tests/dungeonChallengeAuthoritative.test.ts --reporter=verbose",
    "test:weapon-simulation": "vitest run tests/weaponProfilesSimulation.test.tsx --reporter=verbose",
    "test:state-simulation": "vitest run tests/canonicalStateCompatibilitySimulation.test.ts --reporter=verbose",
    "test:bootstrap-simulation": "vitest run tests/bootstrapLatencySimulation.test.ts --reporter=verbose",
    "test:egress-budget": "vitest run tests/egressBudget.test.ts --reporter=verbose",
    "test:immigration-simulation": "vitest run tests/immigrationReconciliationSimulation.test.ts tests/immigrationFrontendIntegration.test.tsx --reporter=verbose",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage --run",
    "check:coverage": "node scripts/check-coverage-thresholds.mjs",
    "check": "npm run board:validate && npm run check:secrets && npm run check:logs && npm run check:migrations && npm run typecheck && npm run lint && npm test -- --run && npm run test:coverage && npm run check:coverage && npm run test:db && npm run test:layout-browser && npm run test:browser && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "supabase": "2.109.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
